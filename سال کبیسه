def is_leap_year(year):
     
    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)

def main():
    try:
    
        year = int(input("Enter year: "))
        
        print(is_leap_year(year))
        
    except ValueError:
        print("Error: Please enter a valid integer.")

