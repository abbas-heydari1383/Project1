import turtle
import random

screen = turtle.Screen()
screen.bgcolor("white")
screen.title("Chaos Game")

t = turtle.Turtle()
t.speed(0)
t.hideturtle()

R = (-300, -250)
G = (300, -250)
B = (0, 270)

t.penup()
t.goto(R)
t.pendown()
t.color("black")
t.pensize(2)
t.goto(G)
t.goto(B)
t.goto(R)

vertices = [
    (R, "red"),
    (G, "green"),
    (B, "blue")
]

n = int(input("Enter n: "))

x, y = R

t.penup()

for i in range(n):
    point, color = random.choice(vertices)

    x = (x + point[0]) / 2
    y = (y + point[1]) / 2

    t.goto(x, y)
    t.dot(4, color)

turtle.done()
