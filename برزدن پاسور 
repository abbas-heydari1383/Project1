import random

SUITS = ['clubs', 'diamonds', 'Hearts', 'spades']
RANKS = ['2', '3', '4', '5', '6', '7', '8', '9', '10', 'Jack', 'Queen', 'King', 'Ace']

deck = []
for s in SUITS:
    for r in RANKS:
        deck.append(r + ' of ' + s)

n = len(deck)
for i in range(n):
    r = random.randrange(0, i + 1)
    temp = deck[r]
    deck[r] = deck[i]
    deck[i] = temp

random_card = random.choice(deck)
print(random_card)